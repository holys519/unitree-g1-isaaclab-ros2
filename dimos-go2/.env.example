# Copy to .env and set this when you know the Go2 IP.
# Example: ROBOT_IP=<GO2_IP_ADDRESS>
ROBOT_IP=

# Use all GPUs by default. Set to 0 or 1 if you want to restrict DimOS.
NVIDIA_VISIBLE_DEVICES=all

# Change this if the default container name conflicts on your machine.
CONTAINER_NAME=dimos-go2-cu124
